{
  "name": "customer-drip-profile",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {"FUNDAMENTAL_SETUP_SHA256": "deed503840e04419fb58908557064eb77a69d42e43fafd5794cd540759479a72", "ACCOUNT_OWNER_PASSWORD_HASH": "005db0a6a5cbd19ae123f8b949e16f15a7c956aa288648a3dc279c83f0de776a"},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "customer-drip-profile", "database_id": "dd158881-8762-4a83-a872-f9179e6c00d5" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RT", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
